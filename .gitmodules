	ignore = all
[submodule "laravel-app"]
	path = laravel-app
	url = https://github.com/Hub-Festa/festou_api.git
	ignore = all
[submodule "foundation_documentation"]
	path = foundation_documentation
	url = https://github.com/Hub-Festa/festou_foundation_documentation.git
	ignore = all
[submodule "web-app"]
	path = web-app
	url = https://github.com/Hub-Festa/festou_web.git
	ignore = all
